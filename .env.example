# --- Telegram ---
BOT_TOKEN=123456:replace-with-token-from-BotFather
# Твой Telegram ID (узнать: @userinfobot). Это единственный админ.
ADMIN_TELEGRAM_ID=
# Куда слать служебные уведомления админу (по умолчанию — ADMIN_TELEGRAM_ID)
ADMIN_CHAT_ID=

# --- Режим работы ---
# polling — long polling, домен и HTTPS не нужны (по умолчанию)
# webhook — нужен HTTPS-домен, см. README
BOT_MODE=polling
WEBHOOK_URL=
# 16+ символов: A-Z a-z 0-9 _ -
WEBHOOK_SECRET=

# --- HTTP (health, webhook) ---
HTTP_HOST=0.0.0.0
HTTP_PORT=3000

# --- База данных ---
# Локально (docker compose up db): postgresql://bot:bot@localhost:5432/bot
DATABASE_URL=postgresql://bot:bot@localhost:5432/bot
# Для docker-compose
POSTGRES_USER=bot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bot

# --- Шифрование (коды подарочных карт) ---
# 32 байта в base64:  openssl rand -base64 32
# ПОТЕРЯ КЛЮЧА = потеря зашифрованных кодов. Храни копию отдельно от бэкапов БД.
ENCRYPTION_KEY=
# Номер текущего ключа и старые ключи — для ротации (см. scripts/rotate-key.ts). Новому ключу ставьте id на 1 больше.
ENCRYPTION_KEY_ID=1
ENCRYPTION_KEYS_OLD=

# --- Mini App ---
# Публичный HTTPS-адрес приложения (Telegram требует https): https://<домен>/app/
# Пусто — Mini App не подключается к боту (API и статика всё равно работают локально).
WEBAPP_URL=
# Каталог сборки (pnpm webapp:build), по умолчанию webapp/dist
WEBAPP_DIST=webapp/dist
# Максимальный возраст подписи initData, секунд (по умолчанию 24 ч)
WEBAPP_INITDATA_TTL_SEC=86400

# --- Бэкапы ---
# Настройки самих бэкапов (ключ шифрования age, расписание, внешнее хранилище) — в отдельном файле backup.env
# (cp backup.env.example backup.env), чтобы секреты бэкапов не попадали в контейнер приложения.
# Максимальный возраст последнего успешного бэкапа, после которого бот оповестит админа (часы):
BACKUP_MAX_AGE_HOURS=36

# --- Проверка ссылок ---
# Необязательно: ключ Google Safe Browsing API (https://developers.google.com/safe-browsing). Проверяется только домен
# (полный адрес оплаты со вшитым токеном наружу не отправляется). Чёрный список и проверка похожих доменов работают и без ключа.
SAFE_BROWSING_API_KEY=

# --- Внешний мониторинг ---
# URL «ping» из healthchecks.io / Uptime Kuma (push). Бот вызывает его после каждого успешного прохода планировщика (раз в 5 мин).
# Настройте в сервисе «ожидать пинг раз в 5 минут, тревога через 15» — тогда вы узнаете и о полном падении сервера.
HEARTBEAT_URL=

# --- Прочее ---
TIMEZONE=Europe/Moscow
LOG_LEVEL=info

# --- Пополнение в USDT (TRC-20) ---
# Публичный адрес кошелька (сеть TRON). Приватные ключи на сервер НЕ кладутся. Пусто — функция выключена.
# Перед включением убедитесь, что приём криптовалюты законен в вашей юрисдикции.
CRYPTO_USDT_TRON_ADDRESS=
# Ключ TronGrid (https://www.trongrid.io) — бесплатный, но без него запросы быстро упираются в лимит.
TRONGRID_API_KEY=
