# Настройки контейнера backup (cp backup.env.example backup.env). Файл НЕ коммитится (.gitignore).

# Публичный ключ age для шифрования бэкапов. Создайте пару ключей на СВОЁМ компьютере (не на сервере):
#   age-keygen -o age-key.txt
# В строку ниже — публичный ключ («Public key: age1…» из вывода). Приватный ключ age-key.txt спрячьте
# (менеджер паролей и офлайн-копия): без него бэкап не расшифровать, а сервер ключа не знает.
BACKUP_AGE_RECIPIENT=

# Расписание (cron, часовой пояс TIMEZONE) и срок хранения локальных копий, дни
BACKUP_CRON=30 3 * * *
BACKUP_KEEP_DAYS=14

# Копия во внешнее хранилище (необязательно, но настоятельно рекомендуется: бэкап на том же сервере не спасёт от потери сервера).
# Файл уже зашифрован — хранилищу доверять не обязательно. Пример для S3-совместимого (Backblaze B2, Wasabi, Yandex Object Storage…):
#   BACKUP_RCLONE_REMOTE=offsite:my-bucket/bot
#   RCLONE_CONFIG_OFFSITE_TYPE=s3
#   RCLONE_CONFIG_OFFSITE_PROVIDER=Other
#   RCLONE_CONFIG_OFFSITE_ENDPOINT=https://s3.example.com
#   RCLONE_CONFIG_OFFSITE_REGION=us-east-1
#   RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=
#   RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=
BACKUP_RCLONE_REMOTE=

# Внешний «пульс» бэкапа (необязательно): URL «ping» из healthchecks.io или Uptime Kuma (push-монитор).
# Контейнер вызывает его после каждого УСПЕШНОГО бэкапа; нет вызова дольше срока — сервис пишет вам сам,
# даже если сервер недоступен целиком.
BACKUP_HEARTBEAT_URL=
